# Environment Variables for Baagupadu AI Backend

# The LLM Provider to use. Options: bedrock, openai, gemini, anthropic, ollama
LLM_PROVIDER=bedrock

# --- AWS Bedrock Configuration ---
# AWS credentials must be configured either via ~/.aws/credentials or environment variables:
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# --- Alternative LLM Providers ---
# API Keys (Fill in the one you are using if not using Bedrock)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local Ollama Configuration (if using ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_CHAT_MODEL=llama3.1:latest
OLLAMA_LOGIC_MODEL=llama3.1:latest

# --- Production Settings (College Server) ---
# To use production, change LLM_PROVIDER to 'vllm'
# VLLM_BASE_URL=http://<COLLEGE_SERVER_IP>:8000/v1
# VLLM_API_KEY=your_secure_api_key
# VLLM_CHAT_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct7b

# Database Configuration (pgvector required)
DATABASE_URL=postgresql+asyncpg://user:password@localhost/baagupadu
